# ── Blockchain ─────────────────────────────────────────────────
# MetaMask private key for contract deployment + on-chain transactions
# Export from MetaMask: Account Details → Export Private Key
PRIVATE_KEY=0x<your_metamask_private_key>

# Optional: custom RPC endpoint (defaults to https://evmrpc-testnet.0g.ai)
OG_RPC_URL=https://evmrpc-testnet.0g.ai

# ── Python Agent Keys (one per hospital) ──────────────────────
# Each hospital agent uses its own wallet key.
# Fund each from the Newton faucet: https://faucet.0g.ai
AGENT_A_KEY=0x<kerala_hospital_private_key>
AGENT_B_KEY=0x<nus_medical_private_key>
AGENT_C_KEY=0x<tokyo_hospital_private_key>
AGENT_D_KEY=0x<bangkok_hospital_private_key>
AGENT_E_KEY=0x<mumbai_hospital_private_key>

# ── Contract ────────────────────────────────────────────────────
# Set after deploying: npx hardhat run scripts/deploy.ts --network og_newton
CONTRACT_ADDRESS=0x<deployed_contract_address>

# ── 0G Compute TeeML ────────────────────────────────────────────
# Run compute starter kit locally (https://github.com/0glabs/0g-compute-ts-starter-kit)
# npm install && npm start  →  then fund ledger with 3 OG
COMPUTE_API_URL=http://localhost:4000

# Optional: override the default TeeML provider address
# TEE_PROVIDER_ADDRESS=0xf07240Efa67755B5311bc75784a061eDB47165Dd
